{
  "manifest_version": 3,
  "name": "WeDocIt - Smart Test & Guide Documenter",
  "version": "1.0.0",
  "description": "Pembuat dokumen pengujian (Unit Test, SIT, UAT) dan panduan langkah otomatis berbahasa Indonesia dengan tangkapan layar pintar.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "libs/*",
        "icons/*",
        "templates/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "windows": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Ambil Screenshot Layar Penuh (1 Layar)"
    }
  }
}