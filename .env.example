# ====================================================================
# WeDocIt v2.0 - Konfigurasi Server & Kredensial Uji Otomatis
# ====================================================================
# Salin file ini menjadi .env
# File .env, .auth/, dan seluruh turunannya SUDAH DI-IGNORE oleh Git (.gitignore)
# sehingga aman dan tidak akan pernah ter-push ke repository.

# URL Server Aplikasi (Bisa disesuaikan ke Dev / Staging / UAT)
FAST_BASE_URL=https://amsfast-dev.bni.co.id:8081
FAST_LOGIN_PATH=/login

# Kredensial Uji Akun
FAST_USERNAME=
FAST_PASSWORD=
FAST_LOGIN_TYPE=HQ
FAST_RESET_PASSWORD=ResetBni
