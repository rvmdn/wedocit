# ====================================================================
# WeDocIt v2.0 - Konfigurasi Server, Multi-Role, & Metadata Dokumen
# ====================================================================
# Salin file ini menjadi .env
# File .env dan direktori .auth/ 100% DI-IGNORE oleh Git (.gitignore)

# 1. Parameter Aplikasi Web (Bisa digunakan untuk aplikasi apa pun)
APP_BASE_URL=https://amsfast-dev.bni.co.id:8081
APP_LOGIN_PATH=/login
FAST_RESET_PASSWORD=ResetBni

# 2. Multi-Role Kredensial Uji
# Role: DEFAULT / ANGGOTA
FAST_USERNAME=900097
FAST_PASSWORD=bni1234/
FAST_LOGIN_TYPE=HQ

# Role: KATIM (Team Leader)
FAST_USER_KATIM=
FAST_PASS_KATIM=

# Role: PKA (Pengendali Teknis / Supervisor)
FAST_USER_PKA=
FAST_PASS_PKA=

# 3. Metadata Dokumen Resmi BNI EDV (Cover, Header, Tabel 2.1, Bab 3)
DOC_SYSTEM_NAME=AMS Fast
DOC_PROJECT_NAME=AMS (Audit Management System)
DOC_CR_NO=CR_AMS_2026_OFFLINE
DOC_TITLE=Unit Test Documentation - Pelaksanaan Audit (Offline & Online)
DOC_MODULE=Pelaksanaan Audit
DOC_SHORT_DESC=Modul Pelaksanaan Audit mencakup AP Non-Kredit, Pengujian AP, AP Kredit, RHA, dan Pelaksanaan Audit Online.
DOC_SCOPE=Pengujian menyeluruh modul Pelaksanaan Audit Offline (AP Non-Kredit, Pengujian AP, AP Kredit, RHA) dan Pelaksanaan Audit Online
DOC_CRITERIA=Seluruh skenario pengujian (Rich Text Jodit Editor, Notifikasi, Validasi Upload Lampiran, dan Hak Akses Role) berjalan sukses dan data tersimpan di sistem.
DOC_TESTED_BY=Irvan Ramadan
DOC_NPP=822117
DOC_START_DATE=19/08/2026
DOC_END_DATE=27/10/2026
DOC_DATE=27/10/2026
DOC_YEAR=2026

