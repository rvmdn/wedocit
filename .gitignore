# Icon\r
._*
.Spotlight-V100
.Trashes

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Node / NPM (jika nanti menggunakan build tools atau package manager)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build & Bundled Output (misal file zip/crx ekstensi untuk release)
*.zip
*.crx
*.pem
dist/
build/
out/

# Environment & Credentials
.env
.env.*
.env.local
.env.*.local
*.key
.auth/

# Temporary files & Logs
*.log
scratch/
test-results/
output/
playwright-report/
logs/
*.log
scratch/
tmp/
temp/

# User Word Templates (agar file template internal/korporat tidak ikut ter-push ke GitHub)
templates/*
!templates/README.md

# Local Desktop Workspace
data/*.json
!data/.gitkeep
wedocit_workspace_cleansed.json

